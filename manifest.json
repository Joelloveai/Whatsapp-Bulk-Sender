{
  "manifest_version": 3,
  "name": "WhatsApp Bulk Sender Pro",
  "version": "1.0",
  "description": "Send unlimited personalized WhatsApp messages",
  "permissions": ["scripting", "storage", "tabs", "activeTab"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Bulk Sender Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["ExtPay.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["ExtPay.js"],
      "matches": ["https://extensionpay.com/*"]
    }
  ]
}